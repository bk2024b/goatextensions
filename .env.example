# Mot de passe de la page /admin (obligatoire pour voir les statistiques).
# Choisissez une phrase longue : elle sert aussi à signer le cookie de session.
ADMIN_PASSWORD=

# Ajouté automatiquement par Vercel quand vous connectez un store Blob au projet
# (Storage > Blob > Connect Project). En local, laissez vide : les compteurs vont dans .data/
BLOB_READ_WRITE_TOKEN=

# Facultatif : "private" si votre store Blob est privé (par défaut "public").
# BLOB_ACCESS=public

# Facultatif : adresse publique du site (sitemap, partage social). Vercel la fournit sinon.
# SITE_URL=https://goat-extensions.example
